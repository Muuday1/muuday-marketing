# =============================================================================
# Brasil Global Marketing Machine — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI Providers ────────────────────────────────────────────────────────────
# OpenAI — GPT-4.1 for structured output, GPT-4o-mini for copy
OPENAI_API_KEY=sk-your-openai-key

# Anthropic — Claude 3.7 for premium copy
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# DeepSeek — V3 for budget/volume tasks
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ─── Image Generation ────────────────────────────────────────────────────────
# fal.ai — FLUX 2 (default image generation)
FAL_KEY=your-fal-key

# Replicate — video generation (Pika, Kling, etc.)
REPLICATE_API_TOKEN=r8_your-replicate-token

# ─── Voice / Audio ───────────────────────────────────────────────────────────
# ElevenLabs — podcast narration and voiceovers
ELEVENLABS_API_KEY=your-elevenlabs-key

# ─── Meta / Facebook Ads ─────────────────────────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
META_VERIFY_TOKEN=your-meta-verify-token
META_AD_ACCOUNT_ID=act_your-ad-account-id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase — same instance as main app, marketing_ prefixed tables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── CMS ─────────────────────────────────────────────────────────────────────
# Sanity — content management
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-token

# ─── Analytics ───────────────────────────────────────────────────────────────
# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend — transactional and newsletter emails
RESEND_API_KEY=re_your-resend-key

# ─── Cache / Rate Limiting ───────────────────────────────────────────────────
# Upstash Redis — serverless Redis for caching and rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Automation ──────────────────────────────────────────────────────────────
# Make.com — webhook URLs for automation workflows
MAKE_WEBHOOK_URL=https://hook.make.com/your-webhook-url

# ─── Security ────────────────────────────────────────────────────────────────
# App secret — used for webhook signature validation, JWT signing, etc.
# Must be at least 32 characters in production.
APP_SECRET=your-32-char-minimum-app-secret-here
