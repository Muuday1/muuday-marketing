{
  "name": "social-media-machine",
  "version": "0.4.0",
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "content:generate": "tsx scripts/generate-content.ts",
    "podcast:generate": "tsx scripts/generate-podcast.ts",
    "meta:sync": "tsx --env-file=.env.local scripts/sync-meta-ads.ts",
    "publish:due": "tsx scripts/publish-due.ts",
    "pipeline": "tsx scripts/content-pipeline.ts",
    "schedule": "tsx scripts/schedule-post.ts",
    "test:supabase": "tsx scripts/test/test-supabase.ts",
    "test:openai": "tsx scripts/test/test-openai.ts",
    "test:instagram": "tsx scripts/test/test-instagram.ts",
    "test:meta-ads": "tsx scripts/test/test-meta-ads.ts",
    "test:elevenlabs": "tsx scripts/test/test-elevenlabs.ts",
    "test:kimi": "tsx scripts/test/test-kimi.ts",
    "test:ai": "tsx scripts/test/test-ai.ts",
    "test:all": "npm run test:supabase && npm run test:ai",
    "session:start": "node scripts/session-start.js",
    "session:end": "node scripts/session-end.js",
    "db:generate": "supabase gen types --lang=typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/types/database.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@fal-ai/client": "^1.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "mixpanel-browser": "^2.80.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/testing-library": "^0.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
